# Copy to .env and fill in. Never commit the real .env.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
PUBLIC_URL=http://localhost:3000

# Show OTP codes on screen and use simulated payments (presentations only; refused in production).
DEMO_MODE=true

# Comma-separated mobile numbers that get the reviewer/admin role.
ADMIN_PHONES=09120000000
# Demo mode only: admins enter this key too before their login code appears on screen. Keep it secret.
ADMIN_LOGIN_KEY=

# 32-byte key, 64 hex chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production. Losing it makes encrypted identities and documents unreadable.
DATA_KEY=

# Set true when running behind nginx/a load balancer so client IPs are correct.
TRUST_PROXY=false

# SMS: console (dev only) | kavenegar
SMS_PROVIDER=console
SMS_API_KEY=
SMS_TEMPLATE=

# Payment gateway: mock (dev only) | zarinpal
PAYMENT_PROVIDER=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# Bill inquiry/payment: mock (format check only) | http (your bank/fintech API)
BILLPAY_PROVIDER=mock
BILLPAY_API_KEY=
